# Copie para deploy/stack.env (NÃO versionado) e preencha com valores reais.
# Depois: set -a; . deploy/stack.env; set +a; docker stack deploy -c deploy/azit-stack.swarm.yml azit

# Senha do Postgres próprio do Azit (invente uma forte).
POSTGRES_PASSWORD=troque_por_uma_senha_forte

# Segredo do JWT (gere: openssl rand -hex 32).
JWT_SECRET=troque_por_um_hex_de_64_chars

# Asaas — URL e chave andam JUNTAS (chave sandbox só funciona na URL sandbox):
#   homologação: https://api-sandbox.asaas.com/v3  + chave do painel sandbox
#   produção:    https://api.asaas.com/v3          + chave do painel real
# Se ASAAS_API_URL ficar vazia/ausente, o stack usa o sandbox por padrão.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=sua_chave_sandbox_asaas
ASAAS_WEBHOOK_SECRET=um_token_que_voce_escolhe_e_poe_igual_no_painel_asaas

# Entrar com Google (doc 06 v1.1 §2.2) — client id do cliente OAuth "Azit Hub Web"
# (projeto azit-hub, deploy/AMBIENTES.md §1.5). É PÚBLICO; não existe client secret
# neste fluxo. Vai para o backend (GOOGLE_CLIENT_ID) e para o build do frontend
# (VITE_GOOGLE_CLIENT_ID). Vazio = botão "Entrar com Google" não aparece.
GOOGLE_CLIENT_ID=43681993535-8orbgnirmtc7p3lbu5ov0f2hvfp46g58.apps.googleusercontent.com

# Alertas por e-mail (doc 06 v1.1 §12.4 — passo a passo em deploy/AMBIENTES.md §1.7).
# EMAIL_TRANSPORTE: smtp-relay (relay SMTP do Workspace, o ESCOLHIDO — sem senha,
# IP do servidor liberado no Admin), gmail-api (conta de serviço; exige a chave
# JSON em GOOGLE_SERVICE_ACCOUNT_JSON, hoje bloqueada pela política da
# organização) ou nenhum (padrão: a fila registra "não configurado" e o sino segue).
# EMAIL_REMETENTE: caixa do domínio que assina os e-mails (ex.: hub@azitmove.com.br).
EMAIL_TRANSPORTE=smtp-relay
EMAIL_REMETENTE=hub@azitmove.com.br
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
GOOGLE_SERVICE_ACCOUNT_JSON=
